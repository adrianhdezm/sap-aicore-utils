{
  "name": "@ai-foundry/sap-aicore-provider",
  "description": "SAP AI Core Foundation Models provider plugin for Vercel AI SDK",
  "version": "0.0.20",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adrianhdezm/sap-aicore-utils.git",
    "directory": "packages/sap-aicore-provider"
  },
  "keywords": [],
  "author": "Adrian Hernandez Mendez",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/adrianhdezm/sap-aicore-utils/issues"
  },
  "homepage": "https://github.com/adrianhdezm/sap-aicore-utils/tree/main/packages/sap-aicore-provider#readme",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": "./dist/index.js",
      "default": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "exports:check": "attw --pack . --ignore-rules=cjs-resolves-to-esm",
    "typecheck": "tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "ci:check": "pnpm run build && pnpm run exports:check && pnpm run typecheck && pnpm run lint && pnpm run test"
  },
  "devDependencies": {
    "@ai-foundry/eslint-config": "workspace:*",
    "@ai-foundry/typescript-config": "workspace:*",
    "@arethetypeswrong/cli": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@ai-foundry/sap-aicore-nano-sdk": "workspace:*",
    "@ai-sdk/openai-compatible": "^2.0.51",
    "@ai-sdk/provider": "^3.0.10",
    "@ai-sdk/provider-utils": "^5.0.2",
    "zod": "^4.4.3"
  }
}
