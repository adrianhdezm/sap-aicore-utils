{
  "name": "@ai-foundry/sap-aicore-nano-sdk",
  "description": "Lightweight SDK for SAP AI Core API authentication and deployment management",
  "version": "0.0.18",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adrianhdezm/sap-aicore-utils.git",
    "directory": "packages/sap-aicore-nano-sdk"
  },
  "keywords": [
    "sap",
    "aicore",
    "sdk",
    "authentication",
    "deployment"
  ],
  "author": "Adrian Hernandez Mendez",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/adrianhdezm/sap-aicore-utils/issues"
  },
  "homepage": "https://github.com/adrianhdezm/sap-aicore-utils/tree/main/packages/sap-aicore-nano-sdk#readme",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": "./dist/index.js",
      "default": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "exports:check": "attw --pack . --ignore-rules=cjs-resolves-to-esm",
    "typecheck": "tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "ci:check": "pnpm run build && pnpm run exports:check && pnpm run typecheck && pnpm run lint && pnpm run test"
  },
  "devDependencies": {
    "@ai-foundry/eslint-config": "workspace:*",
    "@ai-foundry/typescript-config": "workspace:*",
    "@arethetypeswrong/cli": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
